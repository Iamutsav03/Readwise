# Copy this file to .env and fill in your values

# Server port (Render will automatically provide PORT for web services)
PORT=5000

# MongoDB Atlas connection string with credentials
# Example: mongodb+srv://username:password@cluster0.mongodb.net/readwise?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/readwise
 
# Frontend origin allowed for CORS
# Example: https://your-frontend.vercel.app
CORS_ORIGIN=http://localhost:3000
